#!/usr/bin/env bash
set -euo pipefail
ROOT=$(cd "$(dirname "$0")/.." && pwd)
source "$ROOT/bin/config.sh"
: "${MASTER_HOST:?Set MASTER_HOST to the local LAN IP}"
: "${HP_NODE_HOST:?Set HP_NODE_HOST to the HP LAN IP}"
"$ROOT/bin/sync-node" "${HP_HOST:-hp}"
MASTER_HOST=$MASTER_HOST "$ROOT/bin/node" start-master
MASTER_HOST=$MASTER_HOST NODE_HOST=$MASTER_HOST WORKER_CORES=${LOCAL_CORES:-2} WORKER_MEMORY=${LOCAL_MEMORY:-2048m} \
  "$ROOT/bin/node" start-worker
ssh -F "${SSH_CONFIG:-$HOME/.ssh/config}" "${HP_HOST:-hp}" \
  "cd cluster-epsilon && MASTER_HOST=$MASTER_HOST NODE_HOST=$HP_NODE_HOST WORKER_CORES=${HP_CORES:-2} WORKER_MEMORY=${HP_MEMORY:-1024m} bin/node start-worker"
ready=false
for _ in $(seq 1 30); do
  if curl -fsS --max-time 2 "http://$MASTER_HOST:8080/json/" | \
    python3 -c 'import json,sys; d=json.load(sys.stdin); sys.exit(0 if sum(w.get("state") == "ALIVE" for w in d.get("workers", [])) >= 2 else 1)' 2>/dev/null; then
    ready=true
    break
  fi
  sleep 2
done
if [[ $ready != true ]]; then
  echo "ERROR: Master UI did not report two ALIVE workers within 60 seconds" >&2
  exit 1
fi
echo "Master UI: http://$MASTER_HOST:8080"
echo "HP worker UI: http://$HP_NODE_HOST:8081"

