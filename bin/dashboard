const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const pct=(v,total)=>total?Math.max(0,Math.min(100,100*v/total)):0;
const rate=n=>{if(n==null)return '—';const u=['B/s','KB/s','MB/s','GB/s'];let i=0;while(n>=1024&&i<u.length-1){n/=1024;i++}return `${n.toFixed(i?1:0)} ${u[i]}`};
function meter(value,label){let p=Math.round(value||0);return `<div>${label}</div><div class="bar"><i style="width:${p}%"></i></div>`}
