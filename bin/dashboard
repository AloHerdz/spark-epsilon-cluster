def human_bytes(value):
    value = float(value or 0)
    for unit in ("B", "KiB", "MiB", "GiB", "TiB"):
        if value < 1024 or unit == "TiB":
            return f"{value:.1f} {unit}"
        value /= 1024


def collect_metrics(destination):
    command = ["python3", "-c", REMOTE_METRICS, destination]
    result = subprocess.run(command, capture_output=True, text=True, timeout=4)
    result.check_returncode()
    return json.loads(result.stdout)


def local_metrics(destination):
    try:
        return collect_metrics(destination)
    except Exception as exc:
        return {"hostname": socket.gethostname(), "error": str(exc), "connections": []}


def remote_metrics(alias, destination):
    if not re.fullmatch(r"[A-Za-z0-9_.-]+", alias):
        return {"error": "SSH alias contiene caracteres no admitidos", "connections": []}
    remote_command = "python3 -c " + shlex.quote(REMOTE_METRICS) + " " + shlex.quote(destination)
    command = ["ssh", "-F", SSH_CONFIG, "-o", "BatchMode=yes", "-o", f"ConnectTimeout={SSH_TIMEOUT}", alias, remote_command]
    try:
        result = subprocess.run(command, capture_output=True, text=True, timeout=SSH_TIMEOUT + 2)
        result.check_returncode()
        return json.loads(result.stdout)
    except Exception as exc:
        return {"error": str(exc), "connections": []}


def rates(key, sample):
    now = time.monotonic()
    with RATE_LOCK:
        old = RATE_CACHE.get(key)
        RATE_CACHE[key] = (now, sample.get("rx", 0), sample.get("tx", 0), sample.get("cpu", []))
    if not old:
        return None, None, None
    elapsed = max(now - old[0], 0.001)
    rx = max(0, sample.get("rx", 0) - old[1]) / elapsed
    tx = max(0, sample.get("tx", 0) - old[2]) / elapsed
    old_cpu, new_cpu = old[3], sample.get("cpu", [])
    cpu_pct = None
    if len(old_cpu) >= 4 and len(new_cpu) >= 4:
        total_delta = sum(new_cpu) - sum(old_cpu)
        idle_delta = (new_cpu[3] + (new_cpu[4] if len(new_cpu) > 4 else 0)) - (old_cpu[3] + (old_cpu[4] if len(old_cpu) > 4 else 0))
        if total_delta > 0:
            cpu_pct = max(0, min(100, 100 * (total_delta - idle_delta) / total_delta))
    return rx, tx, cpu_pct


def spark_status():
    if not MASTER_HOST:
        return {}, "MASTER_HOST no está configurado"
    try:
        with urlopen(f"http://{MASTER_HOST}:8080/json/", timeout=2.5) as response:
            return json.loads(response.read()), None
    except (URLError, TimeoutError, OSError, ValueError) as exc:
        return {}, str(exc)


def snapshot():
    spark, spark_error = spark_status()
    spark_workers = {}
    for worker in spark.get("workers", []):
        host = worker.get("host")
        if host:
            current = spark_workers.get(host)
            if current is None or worker.get("state") == "ALIVE":
                spark_workers[host] = worker
    targets = [("controlador", MASTER_HOST, None)]
    targets += [(alias, WORKER_IPS.get(alias, ""), alias) for alias in WORKERS]
    destination = next((ip for _, ip, _ in targets[1:] if ip), MASTER_HOST or "127.0.0.1")
    metrics = {}
    with concurrent.futures.ThreadPoolExecutor(max_workers=max(1, len(targets))) as pool:
        futures = {}
        for alias, ip, ssh_alias in targets:
            if ssh_alias is None:
                futures[alias] = pool.submit(local_metrics, destination)
            elif ip and spark_workers.get(ip, {}).get("state") == "ALIVE":
                futures[alias] = pool.submit(remote_metrics, ssh_alias, MASTER_HOST)
            else:
                metrics[alias] = {"error": "nodo apagado o sin registro ALIVE", "connections": []}
        for alias, future in futures.items():
            try:
                metrics[alias] = future.result(timeout=SSH_TIMEOUT + 3)
            except Exception as exc:
                metrics[alias] = {"error": str(exc), "connections": []}

    nodes = []
    alive_hosts = set()
    free_cores = 0
    for alias, ip, ssh_alias in targets:
        worker = spark_workers.get(ip, {}) if ip else {}
        state = worker.get("state", "MISSING")
        if state == "ALIVE" and ip:
            alive_hosts.add(ip)
            cores = int(worker.get("cores", 0) or 0)
            used = int(worker.get("coresused", 0) or 0)
            free = int(worker.get("coresfree", max(0, cores-used)) or 0)
            free_cores += free
        m = metrics.get(alias, {"connections": []})
        rx_rate, tx_rate, cpu_pct = rates(alias, m) if "error" not in m else (None, None, None)
        total = int(m.get("memory_total", 0) or 0)
        available = int(m.get("memory_available", 0) or 0)
        node_connections = m.get("connections", []) or []
        nodes.append({
            "alias": alias, "ip": ip, "hostname": m.get("hostname", ""),
            "spark_state": state, "ssh_state": "SSH sin métricas" if m.get("error") else ("SSH OK" if ssh_alias else "local"),
            "cores": int(worker.get("cores", 0) or 0), "cores_used": int(worker.get("coresused", 0) or 0),
            "cores_free": int(worker.get("coresfree", max(0, int(worker.get("cores", 0) or 0)-int(worker.get("coresused", 0) or 0))) or 0),
            "cpu_pct": cpu_pct, "load": ", ".join(f"{x:.2f}" for x in m.get("load", [])),
            "memory_total": total, "memory_used": max(0, total-available),
            "memory_total_human": human_bytes(total), "memory_used_human": human_bytes(max(0,total-available)),
            "disk_pct": m.get("disk_pct"), "interface": m.get("interface"),
            "rx_rate": rx_rate, "tx_rate": tx_rate, "connections": node_connections,
        })
    links = []
    if MASTER_HOST:
        links = [{"name": "Spark Master", "url": f"http://{MASTER_HOST}:8080"},
                 {"name": "Spark App (durante ejecución)", "url": f"http://{MASTER_HOST}:4040"}]
        for alias, ip in WORKER_IPS.items():
            if spark_workers.get(ip, {}).get("state") == "ALIVE":
                links.append({"name": f"Worker {alias}", "url": f"http://{ip}:8081"})
    apps = [{"id": a.get("id", ""), "name": a.get("name", "Spark app")} for a in spark.get("activeapps", [])]
    conn_count = sum(len(n["connections"]) for n in nodes)
    return {"master": MASTER_HOST, "spark_error": spark_error, "nodes": nodes,
            "alive_workers": len(alive_hosts), "expected_workers": len(targets), "free_cores": free_cores,
            "apps": apps, "spark_connection_count": conn_count, "links": links}


class Handler(BaseHTTPRequestHandler):
    def do_GET(self):
        if self.path == "/api/status":
            body = json.dumps(snapshot(), ensure_ascii=False).encode()
            self.send_response(200)
            self.send_header("Content-Type", "application/json; charset=utf-8")
            self.send_header("Cache-Control", "no-store")
        elif self.path == "/" or self.path.startswith("/?"):
            body = HTML.encode("utf-8")
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
        else:
            body = b"Not found"
            self.send_response(404)
            self.send_header("Content-Type", "text/plain; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def log_message(self, fmt, *args):
        sys.stderr.write("dashboard: " + fmt % args + "\n")


if __name__ == "__main__":
    if not MASTER_HOST:
        raise SystemExit("Set MASTER_HOST in cluster.env before launching bin/dashboard.")
    server = ThreadingHTTPServer((DASHBOARD_BIND, DASHBOARD_PORT), Handler)
    print(f"Dashboard: http://{DASHBOARD_BIND}:{DASHBOARD_PORT}")
    print("LAN dashboard; SSH metrics require reachable worker aliases.")
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        print("\nDashboard stopped.")
    finally:
        server.server_close()
