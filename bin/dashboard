#!/usr/bin/env python3
"""LAN-only, dependency-free Spark and host observability dashboard."""
import concurrent.futures
import json
import os
import re
import shlex
import shutil
import socket
import subprocess
import sys
import threading
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.error import URLError
from urllib.request import urlopen


ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
PORTS = {7077, 7078, 8080, 8081, 4040, 37071, 37072}
RATE_CACHE = {}
RATE_LOCK = threading.Lock()
SSH_CONFIG = os.environ.get("SSH_CONFIG", os.path.expanduser("~/.ssh/config"))
SSH_TIMEOUT = int(os.environ.get("SSH_CONNECT_TIMEOUT", "3"))


def read_config():
    values = {}
    path = os.path.join(ROOT, "cluster.env")
    try:
        with open(path, encoding="utf-8") as stream:
            for line in stream:
                match = re.match(r"^\s*([A-Z_]+)\s*=\s*(.*?)\s*(?:#.*)?$", line)
                if match:
                    value = match.group(2).strip().strip("\"'")
                    values[match.group(1)] = value
    except OSError:
        pass
    return values


CONFIG = read_config()
MASTER_HOST = os.environ.get("MASTER_HOST", CONFIG.get("MASTER_HOST", ""))
WORKERS = [x.strip() for x in CONFIG.get("WORKER_HOSTS", "").split(",") if x.strip()]
WORKER_IPS = {}
for item in CONFIG.get("WORKER_IPS", "").split(","):
    if "=" in item:
        alias, address = item.split("=", 1)
        WORKER_IPS[alias.strip()] = address.strip()
DASHBOARD_PORT = int(os.environ.get("DASHBOARD_PORT", "8090"))
DASHBOARD_BIND = os.environ.get("DASHBOARD_BIND", MASTER_HOST or "127.0.0.1")


REMOTE_METRICS = r'''import json,os,re,subprocess,sys,socket
dest=sys.argv[1] if len(sys.argv)>1 else "127.0.0.1"
def read(path):
    try:
        with open(path) as f: return f.read()
    except OSError: return ""
cpu=read("/proc/stat").splitlines()[0].split()[1:]
cpu=list(map(int,cpu[:8])) if cpu else [0]*8
mem={}
for line in read("/proc/meminfo").splitlines():
    p=line.split()
    if len(p)>1: mem[p[0].rstrip(":")]=int(p[1])*1024
total=mem.get("MemTotal",0); available=mem.get("MemAvailable",0)
route=subprocess.run(["ip","route","get",dest],capture_output=True,text=True).stdout.split()
iface=route[route.index("dev")+1] if "dev" in route else ""
rx=tx=0
for line in read("/proc/net/dev").splitlines()[2:]:
    if ":" not in line: continue
    name,vals=line.split(":",1)
    if name.strip()==iface:
        nums=list(map(int,vals.split())); rx=nums[0]; tx=nums[8]; break
disk=os.statvfs("/"); disk_pct=100*(1-disk.f_bavail/disk.f_blocks) if disk.f_blocks else 0
ss=subprocess.run(["ss","-tnH"],capture_output=True,text=True).stdout.splitlines()
ports={7077,7078,8080,8081,4040,37071,37072}; con=[]
for line in ss:
    cols=line.split()
    if len(cols)>=5 and any((":"+str(p)) in cols[-1] or (":"+str(p)) in cols[-2] for p in ports):
        con.append({"state":cols[0],"local":cols[-2],"peer":cols[-1]})
try: load=os.getloadavg()
except OSError: load=[0,0,0]
print(json.dumps({"hostname":socket.gethostname(),"cpu":cpu,"memory_total":total,"memory_available":available,
 "disk_pct":disk_pct,"interface":iface,"rx":rx,"tx":tx,"connections":con[:80],"load":load}))'''


