#!/usr/bin/env bash
set -euo pipefail
ROOT=$(cd "$(dirname "$0")/.." && pwd)
source "$ROOT/bin/config.sh"
ROWS=${1:-512}
"$ROOT/bin/build" >/dev/null
JAVA_BIN=${JAVA_HOME:+$JAVA_HOME/bin/java}
JAVA_BIN=${JAVA_BIN:-$(command -v java || true)}
[[ -x $JAVA_BIN ]] || { echo "Install the pinned Java version with bin/bootstrap-debian master." >&2; exit 1; }
exec "$JAVA_BIN" -cp "$ROOT/build/epsilon-benchmark.jar:$ROOT/runtime/jars/*" MakeSample \
  "$ROWS" "$ROOT/data/sample.libsvm"

