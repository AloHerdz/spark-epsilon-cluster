#!/usr/bin/env bash
set -euo pipefail
ROOT=$(cd "$(dirname "$0")/.." && pwd)
source "$ROOT/bin/config.sh"
: "${MASTER_HOST:?Set MASTER_HOST to master LAN IP}"
TARGET=${1:?Usage: bin/add-worker ssh-alias node-ip}
NODE_IP=${2:?Usage: bin/add-worker ssh-alias node-ip}
[[ $MASTER_HOST =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ && $NODE_IP =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]] || {
  echo "Use IPv4 addresses for MASTER_HOST and node-ip" >&2; exit 2;
}
ssh -F "${SSH_CONFIG:-$HOME/.ssh/config}" "$TARGET" 'java -version 2>&1 | head -1; mkdir -p "$HOME/cluster-epsilon/data" /tmp/epsilon-cluster-data'
"$ROOT/bin/sync-node" "$TARGET"
for FILE in sample.libsvm epsilon_normalized.bz2; do
  if [[ -f "$ROOT/data/$FILE" ]]; then
    rsync -a --partial -e "ssh -F ${SSH_CONFIG:-$HOME/.ssh/config}" \
      "$ROOT/data/$FILE" "$TARGET:cluster-epsilon/data/"
    ssh -F "${SSH_CONFIG:-$HOME/.ssh/config}" "$TARGET" \
      "ln -sfn \"\$HOME/cluster-epsilon/data/$FILE\" /tmp/epsilon-cluster-data/$FILE"
  fi
done
if [[ $(cat "$ROOT/data/epsilon.format" 2>/dev/null || true) == tsv && -f "$ROOT/data/epsilon_train.tsv" ]]; then
  rsync -a --partial -e "ssh -F ${SSH_CONFIG:-$HOME/.ssh/config}" \
    "$ROOT/data/epsilon_train.tsv" "$TARGET:cluster-epsilon/data/"
  ssh -F "${SSH_CONFIG:-$HOME/.ssh/config}" "$TARGET" \
    'ln -sfn "$HOME/cluster-epsilon/data/epsilon_train.tsv" /tmp/epsilon-cluster-data/epsilon_train.tsv'
fi
if [[ $(cat "$ROOT/data/epsilon.format" 2>/dev/null || true) == parquet && -d "$ROOT/data/epsilon-parquet" ]]; then
  rsync -a --partial -e "ssh -F ${SSH_CONFIG:-$HOME/.ssh/config}" \
    "$ROOT/data/epsilon-parquet" "$TARGET:cluster-epsilon/data/"
  ssh -F "${SSH_CONFIG:-$HOME/.ssh/config}" "$TARGET" \
    'ln -sfn "$HOME/cluster-epsilon/data/epsilon-parquet" /tmp/epsilon-cluster-data/epsilon-parquet'
fi
ssh -F "${SSH_CONFIG:-$HOME/.ssh/config}" "$TARGET" \
  "cd cluster-epsilon && MASTER_HOST=$MASTER_HOST NODE_HOST=$NODE_IP WORKER_CORES=${WORKER_CORES:-2} WORKER_MEMORY=${WORKER_MEMORY:-1024m} bin/node start-worker"
echo "Added worker $TARGET at $NODE_IP; submit with CLUSTER_CORES and REQUIRED_HOSTS adjusted."

