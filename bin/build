#!/usr/bin/env bash
set -euo pipefail
ROOT=$(cd "$(dirname "$0")/.." && pwd)
source "$ROOT/bin/config.sh"
JAVA_BIN=${JAVA_HOME:+$JAVA_HOME/bin/java}
JAR_BIN=${JAVA_HOME:+$JAVA_HOME/bin/jar}
JAVA_BIN=${JAVA_BIN:-$(command -v java || true)}
JAR_BIN=${JAR_BIN:-$(command -v jar || true)}
[[ -x $JAVA_BIN && -x $JAR_BIN ]] || {
  echo "The pinned Java JDK is required. Run bin/bootstrap-debian master." >&2; exit 1;
}
SCALA_COMPILER=$(find "$ROOT/runtime/jars" -maxdepth 1 -type f -name 'scala-compiler-2.13.*.jar' -print -quit)
[[ -n $SCALA_COMPILER ]] || {
  echo "Missing Spark/Scala libraries. Run bin/install master first." >&2; exit 1;
}
JARS_CP=$(printf '%s:' "$ROOT"/runtime/jars/*.jar)
CLASSES="$ROOT/build/classes"
rm -rf "$CLASSES"
mkdir -p "$CLASSES"
mapfile -t SOURCES < <(find "$ROOT/src" -maxdepth 1 -name '*.scala' -type f -print | sort)
"$JAVA_BIN" -cp "$JARS_CP" scala.tools.nsc.Main \
  -classpath "$JARS_CP" -deprecation -feature -unchecked \
  -d "$CLASSES" "${SOURCES[@]}"
"$JAR_BIN" cf "$ROOT/build/epsilon-benchmark.jar" -C "$CLASSES" .
echo "$ROOT/build/epsilon-benchmark.jar"

