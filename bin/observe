#!/usr/bin/env bash
set -euo pipefail
ROOT=$(cd "$(dirname "$0")/.." && pwd)
source "$ROOT/bin/config.sh"
: "${MASTER_HOST:?Set MASTER_HOST to master LAN IP}"
curl -fsS "http://$MASTER_HOST:8080/json/" | python3 -c '
import json,sys
d=json.load(sys.stdin)
print("Master:", d.get("url"), "status:", d.get("status"))
for w in d.get("workers", []):
    print("Worker:", w.get("host"), w.get("state"), "cores:", w.get("cores"), "used:", w.get("coresused"))
for a in d.get("activeapps", []):
    print("Application:", a.get("id"), a.get("name"))
'
echo "Configured workers:"
while IFS= read -r target; do
  [[ -n $target ]] || continue
  printf '  %s %s\n' "$target" "$(worker_ip_for "$target" || echo 'IP not set')"
done < <(worker_aliases)
echo "TCP connections involving Spark ports:"
ss -tn | awk 'NR == 1 || /:7077|:7078|:37071|:37072/'
