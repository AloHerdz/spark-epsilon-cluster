#!/usr/bin/env bash
set -euo pipefail
ROOT=$(cd "$(dirname "$0")/.." && pwd)
TARGET=${1:?Usage: bin/sync-node ssh-alias}
SSH_CONFIG=${SSH_CONFIG:-$HOME/.ssh/config}
SSH_CONNECT_TIMEOUT=${SSH_CONNECT_TIMEOUT:-4}
ssh -F "$SSH_CONFIG" -o BatchMode=yes -o ConnectTimeout="$SSH_CONNECT_TIMEOUT" \
  "$TARGET" 'mkdir -p "$HOME/cluster-epsilon"'
rsync -a --exclude='.git/' --exclude='.cache/' --exclude='.agents/' --exclude='.aws/' --exclude='.codex/' --exclude='.ssh/' \
  --exclude='results/' --exclude='logs/' --exclude='cluster.env' \
  --exclude='id_ed25519' --exclude='id_ed25519.pub' --exclude='id_rsa' --exclude='id_rsa.pub' \
  --exclude='authorized_keys' --exclude='known_hosts' --exclude='*.pem' --exclude='*.ppk' \
  --exclude='data/' --exclude='runtime/work/' \
  -e "ssh -F $SSH_CONFIG -o BatchMode=yes -o ConnectTimeout=$SSH_CONNECT_TIMEOUT" \
  "$ROOT/" "$TARGET:cluster-epsilon/"
echo "Project and Spark $([[ -f "$ROOT/runtime/.spark-version" ]] && cat "$ROOT/runtime/.spark-version" || echo runtime) synced to $TARGET"

