# Copy to cluster.env. These are the addresses observed on the wired LAN.
# Razer Ethernet: enx00e04c363ca1. Razer Wi-Fi is 192.168.1.97; use Ethernet.
MASTER_HOST=192.168.1.111
HP_HOST=hp
HP_NODE_HOST=192.168.1.109

# Conservative defaults for the HP (4 CPU / 4.7 GiB RAM).
LOCAL_CORES=2
LOCAL_MEMORY=2048m
HP_CORES=2
HP_MEMORY=1024m
