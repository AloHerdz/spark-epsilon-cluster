# Copy to cluster.env and replace these sample addresses with LAN addresses.
MASTER_HOST=192.168.1.10
WORKER_HOSTS=worker1
WORKER_IPS=worker1=192.168.1.20

# Adjust to the resources available to Spark after leaving room for the OS.
LOCAL_CORES=2
LOCAL_MEMORY=2048m
WORKER_CORES=2
WORKER_MEMORY=2048m

# Tolerate powered-off nodes; the controller counts as one active Spark host.
MIN_ACTIVE_WORKERS=2
SSH_CONNECT_TIMEOUT=4
DASHBOARD_PORT=8090
